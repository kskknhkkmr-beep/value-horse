# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local dev logs
*.log

# claude code
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# 一時分析スクリプト(_*.ts)のデータ退避先
/scripts/_cache/

# バックフィルの小規模テスト用データ（再生成可能）
/lib/backfill-test/
